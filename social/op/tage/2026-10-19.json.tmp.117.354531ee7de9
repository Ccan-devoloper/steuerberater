   "sprecher": [
    {"id": "hook", "text": "Eigentum erst nach der letzten Rate. Die Lieferung ist trotzdem sofort da."},
    {"id": "s1", "text": "Ein Küchenstudio baut Ines im März eine Küche ein. Preis elftausendneunhundert Euro brutto, zehn Raten, Eigentumsvorbehalt."},
    {"id": "s2", "text": "Lieferung heißt Verfügungsmacht. Ines nutzt die Küche wie eine Eigentümerin. Das Eigentum bleibt beim Studio, das ist egal."},
    {"id": "s3", "text": "Also entsteht die ganze Steuer von eintausendneunhundert Euro mit Ablauf des März, nicht Rate für Rate."},
    {"id": "cta", "text": "Merke: Die Übergabe zählt, nicht das Eigentum."}
   ],
