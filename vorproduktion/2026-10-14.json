      "folien": [
        {
          "art": "titel",
          "titel": "Begrenzung des Schulden- und Lastenabzugs: § 10 Abs. 6 und 6a ErbStG",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "§ 10 Abs. 6: Schulden zu Vermögen, das nicht der Erbschaftsteuer unterliegt, sind nicht abziehbar. Bei beschränkter Steuerpflicht sind seit dem JStG 2024 auch nicht zuordenbare Schulden wie der Pflichtteil anteilig abziehbar.",
            "§ 10 Abs. 6a: Schulden zu befreitem Vermögen (z. B. Familienheim) nicht, bei teilweiser Befreiung nur anteilig abziehen; nicht zuordenbare Schulden nach Nettowerten verteilen. Abs. 6b: im Grundbesitzwert erfasste Belastungen nicht doppelt abziehen."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Zuerst feststellen, ob der Fall unbeschränkte oder beschränkte Steuerpflicht bzw. ein beschränktes deutsches Besteuerungsrecht betrifft."
            },
            {
              "titel": "2. Schritt",
              "text": "Schuld zuordnen: zu nicht steuerbarem Vermögen kein Abzug (§ 10 Abs. 6 S. 1 ErbStG), zu voll befreitem kein Abzug, zu teilweise befreitem nur anteilig (§ 10 Abs. 6a ErbStG)."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Befreites Vermögen zieht seine Schulden mit: voll befreit kein Abzug, teilweise befreit nur anteilig."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
