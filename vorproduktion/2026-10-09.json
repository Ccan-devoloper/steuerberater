        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Arbeitszimmer: eigener, büromäßig eingerichteter Raum in der Wohnung, fast nur beruflich genutzt – eine Arbeitsecke reicht nicht.",
            "Mittelpunkt deiner gesamten Betätigung dort: Kosten oder 1.260 € Jahrespauschale (§ 4 Abs. 5 Satz 1 Nr. 6b EStG).",
            "Sonst: Homeoffice-Pauschale von 6 € je Tag, max. 1.260 € im Jahr (§ 4 Abs. 5 Satz 1 Nr. 6c EStG)."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Prüfe, ob ein eigener, fast nur beruflich genutzter Raum vorliegt oder nur ein Arbeitsplatz im privat genutzten Zimmer."
            },
            {
              "titel": "2. Schritt",
              "text": "Mittelpunkt im Arbeitszimmer: Kosten oder 1.260 €. Sonst 6 € je Tag, an dem du überwiegend zu Hause arbeitest und keine erste Tätigkeitsstätte aufsuchst. Fehlt dauerhaft ein anderer Arbeitsplatz, zählen auch Tage, an denen du zusätzlich auswärts arbeitest."
            }
          ]
        },
