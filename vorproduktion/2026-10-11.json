      "folien": [
        {
          "art": "titel",
          "titel": "Gebäudeabriss: Aufwand oder Teil der Anschaffungskosten?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Wurde das Gebäude selbst errichtet oder ohne Abbruchabsicht erworben, sind Restbuchwert und Abbruchkosten sofort abziehbare Betriebsausgaben.",
            "Bei Erwerb in Abbruchabsicht gehören beide zu den Herstellungskosten des neuen Wirtschaftsguts, wenn das Gebäude noch nicht verbraucht war und ein enger Zusammenhang mit der Neuherstellung besteht; fehlt dieser Zusammenhang, erhöhen sie die Anschaffungskosten des Bodens."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Feststellen, ob das Gebäude selbst errichtet, erworben oder eingelegt wurde."
            },
            {
              "titel": "2. Schritt",
              "text": "Bei Erwerb untersuchen, ob eine Abbruchabsicht bestand, und dabei die Dreijahresfrist als Indiz nutzen."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Bei Gebäudeabriss: Aufwand oder Teil der Anschaffungskosten?: erst die Voraussetzungen klären, dann die Rechtsfolge festhalten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
