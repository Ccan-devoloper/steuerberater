          "art": "titel",
          "titel": "Ware geliefert: Ist der Gewinn schon realisiert?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "den Realisationszeitpunkt an Gefahrübergang bzw. Abnahme knüpfen",
            "schwebende Geschäfte vom Bilanzansatz ausnehmen"
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Vertragstyp bestimmen: Kauf, Werkvertrag oder Dauerschuldverhältnis."
            },
            {
              "titel": "2. Schritt",
              "text": "Zeitpunkt der wesentlichen Leistungserbringung feststellen."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Die Antwort",
          "text": "Der Gewinn entsteht bei erfüllter Leistung und Übergang der wesentlichen Risiken, nicht erst mit Ausstellung der Rechnung."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
