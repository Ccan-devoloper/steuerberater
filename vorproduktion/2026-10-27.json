        {
          "art": "titel",
          "titel": "Korrekturpärchen nach Ablauf der regulären Festsetzungsfrist",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "§ 129 AO und § 173a AO: Die Frist läuft insoweit mindestens bis ein Jahr nach Bekanntgabe des fehlerhaften Bescheids (§ 171 Abs. 2 S. 1 und 2 AO).",
            "Ein vor Fristablauf gestellter Änderungsantrag hemmt nach § 171 Abs. 3 AO, ein Einspruch nach § 171 Abs. 3a AO – jeweils bis zur unanfechtbaren Entscheidung."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Reguläre Festsetzungsfrist lückenlos berechnen."
            },
            {
              "titel": "2. Schritt",
              "text": "Ist sie abgelaufen: Korrekturnorm bestimmen und prüfen, ob die dazugehörige Ablaufhemmung noch läuft."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Nach Fristablauf hilft eine Korrekturnorm nur zusammen mit ihrer Ablaufhemmung. Fehlt sie, ist jede Änderung ausgeschlossen – auch die Berichtigung nach § 129 AO (§ 169 Abs. 1 AO)."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
            "lupe",
            "warnung"
          ]
        }
      ],
