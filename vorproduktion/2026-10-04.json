      "folien": [
        {
          "art": "titel",
          "titel": "Was macht Einkünfte eines Gebietsfremden zu inländischen?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Du verstehst, dass § 49 EStG an die Einkunftsarten des § 2 Abs. 1 EStG anknüpft und für jeden Fall ein zusätzliches Inlandsmerkmal verlangt.",
            "Du kennst die wichtigsten Anknüpfungen bei gewerblichen Einkünften: inländische Betriebsstätte oder ständiger Vertreter, Darbietungen im Inland, Anteilsveräußerungen nach § 17 EStG sowie Vermietung oder Veräußerung inländischen Grundbesitzes."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Bestimme zuerst die Einkunftsart nach den allgemeinen Regeln des Einkommensteuergesetzes."
            },
            {
              "titel": "2. Schritt",
              "text": "Suche in § 49 Abs. 1 EStG die zur Einkunftsart gehörende Nummer und prüfe deren konkreten Inlandsbezug."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Bei Was macht Einkünfte eines Gebietsfremden zu inländischen?: erst die Voraussetzungen klären, dann die Rechtsfolge festhalten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
