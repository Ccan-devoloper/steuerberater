      "folien": [
        {
          "art": "titel",
          "titel": "Was macht Einkünfte eines Gebietsfremden zu inländischen?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Du verstehst, dass § 49 EStG an die Einkunftsarten des § 2 Abs. 1 EStG anknüpft und für jeden Fall ein zusätzliches Inlandsmerkmal verlangt.",
            "Typische Inlandsmerkmale: Betriebsstätte oder ständiger Vertreter, Darbietung im Inland, Anteile an inländischen Kapitalgesellschaften (§ 17 EStG), inländischer Grundbesitz."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Bestimme die Einkunftsart; im Ausland verwirklichte Merkmale, die inländische Einkünfte ausschließen würden, bleiben außer Betracht (§ 49 Abs. 2 EStG)."
            },
            {
              "titel": "2. Schritt",
              "text": "Suche in § 49 Abs. 1 EStG die zur Einkunftsart gehörende Nummer und prüfe deren konkreten Inlandsbezug."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Erst die Einkunftsart, dann das Inlandsmerkmal der passenden Nummer in § 49 Abs. 1 EStG. Fehlt es, sind diese Einkünfte nicht inländisch und unterliegen nicht der beschränkten Steuerpflicht (§ 1 Abs. 4 EStG)."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
            "lupe",
            "warnung"
          ]
        }
      ],
      "caption": "Einkünfte eines Gebietsfremden sind nur inländisch, wenn § 49 Abs. 1 EStG für die jeweilige Einkunftsart ein Inlandsmerkmal findet, etwa Betriebsstätte, Grundbesitz, Darbietung im Inland oder Beteiligung an einer inländischen Kapitalgesellschaft.",
