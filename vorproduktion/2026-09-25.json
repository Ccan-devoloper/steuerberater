      "fachLabel": "Umsatzsteuer",
      "themaId": "ust-modul-ust-164",
      "slug": "2026-09-25-b1",
      "folien": [
        {
          "art": "titel",
          "titel": "Vorsteuerabzug und § 14c: gesetzlich geschuldete Steuer statt bloß ausgewiesener Steuer",
          "coverBadge": "Klausurtechnik",
          "coverBildAuslassen": true,
          "titelZeilen": [
            "Vorsteuerabzug",
            "§ 14c: gesetzliche",
            "Steuer statt bloß",
            "ausgewiesener Steuer"
          ]
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Voraussetzungen des Vorsteuerabzugs nach § 15 Abs. 1 S. 1 Nr. 1 UStG prüfen",
            "gesetzlich geschuldete Umsatzsteuer von einer bloßen §-14c-Steuerschuld unterscheiden",
            "unrichtigen und unberechtigten Steuerausweis nach § 14c Abs. 1 und 2 abgrenzen",
            "Endverbraucher-Ausnahme des § 14c Abs. 1 nach EuGH C-794/23 und BFH V R 46/25 berücksichtigen"
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Leistung eines anderen Unternehmers für das Unternehmen feststellen."
            },
            {
              "titel": "2. Schritt",
              "text": "Gesetzlich geschuldete Steuer für die konkrete Lieferung oder sonstige Leistung bestimmen."
            },
            {
              "titel": "3. Schritt",
              "text": "Rechnung nach §§ 14, 14a UStG und Besitz der Rechnung prüfen."
            },
            {
              "titel": "4. Schritt",
              "text": "Bei Vorauszahlungen zusätzlich Zahlung vor Leistungsausführung prüfen."
            },
            {
              "titel": "5. Schritt",
              "text": "Bei problematischem Steuerausweis § 14c gesondert prüfen. Ein nur nach § 14c geschuldeter Betrag ist keine abziehbare Vorsteuer."
            }
          ]
        },
        {
          "art": "text",
          "titel": "Typischer Fehler",
          "punkte": [
            "Jeden gesondert ausgewiesenen Steuerbetrag ungeprüft als Vorsteuer abziehen.",
            "§ 14c Abs. 1 und Abs. 2 vertauschen.",
            "Bei Vorauszahlungen nur auf die Rechnung schauen und die Zahlung übersehen."
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Vorsteuer verlangt gesetzlich geschuldete Steuer. § 14c schafft keinen Vorsteuerabzug; bei § 14c Abs. 1 ist seit BFH V R 46/25 zusätzlich die Endverbraucher-Ausnahme zu beachten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
