          "art": "titel",
          "titel": "Fristenberechnung nach § 108 AO und §§ 187, 188 BGB",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Ereignisfrist: Der Ereignistag, etwa der Tag der Bekanntgabe, zählt nicht mit (§ 187 Abs. 1 BGB).",
            "Eine Monatsfrist endet mit Ablauf des Tages mit derselben Zahl wie der Ereignistag (§ 188 Abs. 2 BGB).",
            "Endet sie an einem Samstag, Sonntag oder Feiertag, gilt der nächste Werktag (§ 108 Abs. 3 AO)."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Ereignis feststellen, z. B. Bekanntgabe: bei Postversand im Inland am vierten Tag nach Aufgabe zur Post (§ 122 Abs. 2 Nr. 1 AO)."
            },
            {
              "titel": "2. Schritt",
              "text": "Beginn: Die Frist läuft ab dem Tag nach dem Ereignis (§ 187 Abs. 1 BGB)."
            },
            {
              "titel": "3. Schritt",
              "text": "Ende nach § 188 Abs. 2 BGB berechnen, dann Wochenende und Feiertag prüfen (§ 108 Abs. 3 AO)."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Ereignistag nicht mitzählen, Ende über § 188 Abs. 2 BGB bestimmen, dann Kalender prüfen: Ein Samstag, Sonntag oder Feiertag schiebt das Fristende auf den nächsten Werktag (§ 108 Abs. 3 AO)."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Thema für die nächste Wiederholung speichern"
          ],
          "icons": [
            "dokument",
            "lupe",
            "buch"
          ]
        }
      ],
      "caption": "Fristen in der AO-Klausur: Ereignistag nicht mitzählen (§ 187 Abs. 1 BGB), Ende nach § 188 Abs. 2 BGB bestimmen und an Wochenende oder Feiertag denken (§ 108 Abs. 3 AO).",
