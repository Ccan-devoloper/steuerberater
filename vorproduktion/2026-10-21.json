      "folien": [
        {
          "art": "titel",
          "titel": "Sachwert statt Geld: Ist das Realteilung?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "echte und unechte Realteilung unterscheiden",
            "reine Barabfindung und Überführung lückenlos ins Privatvermögen von der Realteilung unterscheiden"
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Zuerst klären, ob eine echte Realteilung (Beendigung der Mitunternehmerschaft) oder eine unechte Realteilung (Ausscheiden eines Mitunternehmers bei Fortbestand der Mitunternehmerschaft) vorliegt."
            },
            {
              "titel": "2. Schritt",
              "text": "Untersuchen, ob die übertragenen Wirtschaftsgüter beim Realteiler zumindest teilweise in einem Betriebsvermögen fortgeführt werden."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Die Antwort",
          "text": "Realteilung kann auch beim Ausscheiden eines Partners vorliegen, wenn Wirtschaftsgüter in einem Betriebsvermögen fortgeführt werden."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
