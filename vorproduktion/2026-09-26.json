        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Bestandteile der Gesamtsteuerbilanz benennen",
            "Gesamthand, Sonderbereich und Ergänzungsbereich zuordnen",
            "Gesamtgewinn und Gewinnanteile abstimmen",
            "Spiegelbildmethode bei Beteiligungen verstehen"
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
