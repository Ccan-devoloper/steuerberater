        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "den Grundtatbestand des § 1a Abs. 1 auswendig strukturiert prüfen",
            "§ 3d S. 1 und den Sicherungstatbestand des S. 2 unterscheiden",
            "Steuerentstehung nach § 13 Abs. 1 Nr. 6 zuordnen",
            "Erwerbsteuer und Vorsteuer nach § 15 Abs. 1 S. 1 Nr. 3 spiegelbildlich erfassen"
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "§ 1a Abs. 1: Warenbewegung zwischen zwei Mitgliedstaaten, Erwerberstatus und Liefererstatus prüfen."
            },
            {
              "titel": "2. Schritt",
              "text": "§ 3d S. 1: Ort am Ende der Beförderung oder Versendung."
            },
            {
              "titel": "3. Schritt",
              "text": "Bei fremder USt-IdNr. zusätzlich § 3d S. 2 als Sicherungstatbestand prüfen."
            },
            {
              "titel": "4. Schritt",
              "text": "Steuerbarkeit nach § 1 Abs. 1 Nr. 5, anschließend BMG und Steuersatz prüfen."
            },
            {
              "titel": "5. Schritt",
              "text": "Entstehung nach § 13 Abs. 1 Nr. 6 und Steuerschuldner nach § 13a Abs. 1 Nr. 2 bestimmen."
            }
          ]
        },
        {
          "art": "text",
          "titel": "Typischer Fehler",
          "punkte": [
            "Den Erwerbsort nach dem Sitz des Erwerbers statt nach dem Ende der Warenbewegung bestimmen.",
            "Erwerbsteuer und Vorsteuer saldieren, ohne beide Prüfungsschritte auszuweisen."
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Eine EU-Warenbewegung kann beim Lieferer steuerfrei und beim Erwerber zugleich steuerpflichtiger ig. Erwerb sein."
