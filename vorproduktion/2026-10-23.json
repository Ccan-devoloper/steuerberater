        {
          "art": "titel",
          "titel": "Begünstigtes Vermögen und der 90-%-Test des § 13b ErbStG",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Begünstigt ist der gemeine Wert des begünstigungsfähigen Vermögens, soweit er den Nettowert des Verwaltungsvermögens nach Kürzung um den unschädlichen Teil übersteigt.",
            "Unschädlich sind nach § 13b Abs. 7 ErbStG 10 % des Betriebswerts, der zuvor um den Nettowert des Verwaltungsvermögens vermindert wurde."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Gemeinen Wert des begünstigungsfähigen Vermögens nach § 13b Abs. 1 ErbStG feststellen."
            },
            {
              "titel": "2. Schritt",
              "text": "90-%-Test (§ 13b Abs. 2 S. 2 ErbStG): Verwaltungsvermögen ohne Schuldenquote und 10-%-Kürzung; Finanzmittel bei operativen Betrieben aber nach Abzug betrieblicher Schulden, ohne 15-%-Sockel."
            },
            {
              "titel": "3. Schritt",
              "text": "Unter 90 %: gemeinen Wert um den Nettowert des Verwaltungsvermögens mindern, soweit er den unschädlichen Teil übersteigt (§ 13b Abs. 6, 7 ErbStG)."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Ab 90 % Verwaltungsvermögen fällt die Verschonung komplett weg. Darunter bleibt nur der Nettowert des Verwaltungsvermögens oberhalb des unschädlichen Teils unbegünstigt."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
            "lupe",
            "warnung"
          ]
        }
      ],
      "caption": "Begünstigtes Vermögen nach § 13b ErbStG: erst der 90-%-Test, dann die Rechnung aus gemeinem Wert, Nettowert des Verwaltungsvermögens und unschädlichem Teil. Beim 90-%-Test die Schuldenverrechnung bei den Finanzmitteln nach BFH-Urteil und Ländererlassen 2024 beachten.",
