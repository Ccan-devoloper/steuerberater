      "folien": [
        {
          "art": "titel",
          "titel": "Welche Vorgänge stehen einer schädlichen Anteilsveräußerung gleich?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Gelangen die sperrfristbehafteten Anteile ohne Gegenleistung in eine Kapitalgesellschaft, etwa per verdeckter Einlage, wird der Einbringungsgewinn I nach § 22 Abs. 1 Satz 6 Nr. 1 UmwStG ausgelöst.",
            "Wer die Anteile einer natürlichen Person schenkt, verstößt nicht gegen die Sperrfrist; der Beschenkte tritt nach § 22 Abs. 6 UmwStG in sie ein."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Den Vorgang mit den sperrfristbehafteten Anteilen genau bestimmen: entgeltlich, unentgeltlich, Weitereinbringung oder sonstige Umwandlung."
            },
            {
              "titel": "2. Schritt",
              "text": "Bei Unentgeltlichkeit den Empfänger untersuchen: Kapitalgesellschaft schädlich, natürliche Person Rechtsnachfolge."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Bei Welche Vorgänge stehen einer schädlichen Anteilsveräußerung gleich?: erst die Voraussetzungen klären, dann die Rechtsfolge festhalten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
