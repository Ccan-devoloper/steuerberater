  "inhalte": {
    "b1": {
      "format": "spickzettel",
      "fach": "persg",
      "klausur": 3,
      "fachLabel": "Personengesellschaften",
      "themaId": "persg-aufb-persg-melzer-1-2",
      "slug": "2026-10-17-b1",
      "folien": [
        {
          "art": "titel",
          "titel": "Ist alles Gesellschaftsvermögen einer PersG Betriebsvermögen?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Nach § 39 Abs. 2 Nr. 2 AO gilt das Vermögen einer rechtsfähigen Personengesellschaft für die Ertragsteuern als Gesamthandsvermögen und wird den Gesellschaftern anteilig zugerechnet, soweit die Besteuerung das verlangt.",
            "Was der Gesellschaft zivilrechtlich oder wirtschaftlich gehört, ist handelsrechtlich zu bilanzieren und über die Maßgeblichkeit im Grundfall auch in der Steuerbilanz zu zeigen."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Stelle fest, ob das Wirtschaftsgut der Gesellschaft selbst gehört oder einem, mehreren oder allen Gesellschaftern."
            },
            {
              "titel": "2. Schritt",
              "text": "Gehört es der Gesellschaft, bejahe im Grundfall Betriebsvermögen und suche nur noch nach Gründen für gesamthänderisch gebundenes Privatvermögen."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Bei Ist alles Gesellschaftsvermögen einer PersG Betriebsvermögen?: erst die Voraussetzungen klären, dann die Rechtsfolge festhalten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
