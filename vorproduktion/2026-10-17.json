      "folien": [
        {
          "art": "titel",
          "titel": "Beteiligung an KG oder GmbH: Wie wird sie bilanziert?",
          "coverBadge": "Spickzettel",
          "coverBildAuslassen": true
        },
        {
          "art": "text",
          "titel": "Kern der Prüfung",
          "punkte": [
            "Handelsrechtlich ist die Beteiligung an einer Personengesellschaft ein Vermögensgegenstand mit Anschaffungskosten; steuerlich ist sie kein eigenständiges Wirtschaftsgut.",
            "Steuerlich wird der Anteil an einer Personengesellschaft in Höhe des Kapitals in der Gesellschaft fortgeführt; Gewinnanteile, Verluste, Einlagen und Entnahmen verändern ihn, eine Teilwertabschreibung scheidet aus."
          ]
        },
        {
          "art": "schritte",
          "titel": "So baust du die Prüfung auf",
          "schritte": [
            {
              "titel": "1. Schritt",
              "text": "Feststellen, ob Anteile an einer Personen- oder an einer Kapitalgesellschaft gehalten werden."
            },
            {
              "titel": "2. Schritt",
              "text": "Bei Personengesellschaften das Beteiligungskonto in der Steuerbilanz an das Kapital in der Gesellschaft anpassen."
            }
          ]
        },
        {
          "art": "merke",
          "titel": "Merksatz",
          "text": "Bei Beteiligung an KG oder GmbH: Wie wird sie bilanziert?: erst die Voraussetzungen klären, dann die Rechtsfolge festhalten."
        },
        {
          "art": "cta",
          "titel": "Für die nächste Klausur",
          "punkte": [
            "Tragende Normen im Gesetz markieren",
            "Prüfungsschritte in der richtigen Reihenfolge wiederholen",
            "Typischen Fehler vor der nächsten Klausur kontrollieren"
          ],
          "icons": [
            "dokument",
